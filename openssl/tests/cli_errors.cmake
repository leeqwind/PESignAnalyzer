function(expect_code expected)
    execute_process(COMMAND "${EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "${expected}")
        message(FATAL_ERROR "Expected ${expected}, got ${code}: ${output} ${error}")
    endif()
endfunction()
expect_code(2)
expect_code(2 --verify)
expect_code(2 --revocation invalid sample.exe)
expect_code(2 --network-timeout 0 sample.exe)
expect_code(2 --network-timeout 301 sample.exe)
expect_code(2 --network-timeout text sample.exe)
expect_code(2 --catalog)
expect_code(2 --ca-file)
expect_code(2 --embedded-only --catalog sample.cat sample.exe)
expect_code(2 --embedded-only --catalog-dir catalogs sample.exe)
expect_code(2 --unknown sample.exe)
expect_code(2 first.exe second.exe)
expect_code(3 "${CMAKE_CURRENT_BINARY_DIR}/missing-pe-fixture.exe")
